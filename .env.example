# Supabase Configuration
# Sao chép file này thành .env.local và điền URL, ANON KEY và SERVICE ROLE KEY của dự án Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (BẮT BUỘC để Server Action gọi RPC lưu bảng thuế an toàn)
# TUYỆT ĐỐI KHÔNG thêm tiền tố NEXT_PUBLIC_ vào biến này
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
